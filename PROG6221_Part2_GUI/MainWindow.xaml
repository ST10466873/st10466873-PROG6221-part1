<Window x:Class="PROG6221_Part2_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber-Shield Assistant" Height="650" Width="550" Background="#121212" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1E1E24" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="  ╔═╗╦═╗╦╔╗╔╦═╗╦ ╦   ╔═╗╦ ╦╦═╗╦╔═╗╦╔═╗╦═╗╔═╗
  ╚═╗╠╦╝║║║║╠╦╝╚╦╝───╚═╗║ ║╠╦╝║║ ║║║║╠╦╝║╣ 
  ╚═╝╩╚═╩╝╚╝╩╚═ ╩    ╚═╝╚═╝╩╚═╩╚═╝╩╚╝╩╚═╚═╝"
                           Foreground="#00E5FF" FontSize="10" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="CYBER-SHIELD ASSISTANT" Foreground="#00E5FF" FontSize="14"
                           FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="StatusBar" Text="Connected | MySQL Active"
                           Foreground="#4CAF50" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="#1A1A1A" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#2C2C34"/>
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#2C2C34" BorderBrush="#333" BorderThickness="0,0,1,0" Padding="15,8">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#00E5FF"/>
                                        <Setter Property="Foreground" Value="#121212"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3A3A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- CHAT TAB -->
            <TabItem Header="  CHAT  ">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <Border Background="#1E1E24" CornerRadius="8" Padding="12" BorderBrush="#333" BorderThickness="1">
                            <TextBlock x:Name="ChatDisplay" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserInput" Grid.Column="0" FontSize="13" Padding="8"
                                 Background="#2C2C34" Foreground="White" BorderBrush="#00E5FF" BorderThickness="1"
                                 KeyDown="UserInput_KeyDown"/>
                        <Button Grid.Column="1" Content="SEND" Background="#00E5FF" Foreground="Black"
                                FontWeight="Bold" Margin="8,0,0,0" Click="Send_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TASKS TAB -->
            <TabItem Header="  TASKS  ">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="10" BorderBrush="#333" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Add New Task" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="TaskInput" Background="#2C2C34" Foreground="White"
                                     BorderBrush="#555" BorderThickness="1" Padding="6" FontSize="13"/>
                            <TextBox Grid.Row="2" x:Name="TaskDescInput" Background="#2C2C34" Foreground="White"
                                     BorderBrush="#555" BorderThickness="1" Padding="6" FontSize="12" Margin="0,5,5,0"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="TaskReminderPicker" Background="#2C2C34" Foreground="White"
                                        BorderBrush="#555" Margin="0,5,0,0"/>
                            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="ADD TASK" Background="#00E5FF"
                                    Foreground="Black" FontWeight="Bold" FontSize="13" Padding="8,6" Margin="0,8,0,0"
                                    Click="TaskAdd_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="TaskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="6" Padding="8" Margin="0,0,0,5" BorderBrush="#333" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}" Foreground="#E0E0E0"
                                                       TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="DONE" Background="#4CAF50" Foreground="White"
                                                    FontSize="11" Padding="8,4" Margin="5,0" Tag="{Binding Id}"
                                                    Click="TaskComplete_Click"/>
                                            <Button Grid.Column="2" Content="DEL" Background="#F44336" Foreground="White"
                                                    FontSize="11" Padding="8,4" Tag="{Binding Id}"
                                                    Click="TaskDelete_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#1E1E24" CornerRadius="6" Padding="8" Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TaskStatus" Text="No tasks loaded" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="REFRESH" Background="#FF9800" Foreground="White"
                                    FontWeight="Bold" Padding="12,6" Click="TaskRefresh_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- QUIZ TAB -->
            <TabItem Header="  QUIZ  ">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="10" BorderBrush="#00E5FF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="QuizQuestion" Text="Click 'Start Quiz' to begin!"
                                       Foreground="#E0E0E0" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="QuizScore" Text="Score: 0/0" Foreground="#FF9800"
                                       FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="QuizProgress" Text="Q: 0/11" Foreground="#00E5FF"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" x:Name="QuizFeedbackPanel" Background="#2C2C34" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <TextBlock x:Name="QuizFeedback" Text="" Foreground="#E0E0E0" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="QuizOptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Background="#2C2C34" Foreground="#E0E0E0"
                                            FontSize="13" Padding="10" Margin="0,0,0,5" BorderBrush="#555" BorderThickness="1"
                                            HorizontalContentAlignment="Left" Tag="{Binding Value}"
                                            Click="QuizOption_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="QuizStartBtn" Content="START QUIZ" Background="#00E5FF" Foreground="Black"
                                FontWeight="Bold" FontSize="14" Padding="12,8" Margin="0,0,5,0" Click="QuizStart_Click"/>
                        <Button Grid.Column="1" x:Name="QuizNextBtn" Content="NEXT QUESTION" Background="#FF9800" Foreground="White"
                                FontWeight="Bold" FontSize="14" Padding="12,8" Margin="5,0,0,0" Click="QuizNext_Click"
                                IsEnabled="False"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#1E1E24" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="QuizResult" Text="" Foreground="#4CAF50" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" x:Name="QuizProgressBar" Height="8" Margin="10,0,0,0"
                                         Foreground="#00E5FF" Background="#333" Minimum="0" Maximum="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ACTIVITY LOG TAB -->
            <TabItem Header="  LOG  ">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="8" BorderBrush="#333" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Activity History" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LogCount" Text="0 entries" Foreground="#888" FontSize="12" Margin="10,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="CLEAR" Background="#F44336" Foreground="White" Padding="10,4" FontSize="11" Click="LogClear_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="4" Padding="6" Margin="0,0,0,3" BorderBrush="#2C2C34" BorderThickness="1">
                                        <TextBlock Text="{Binding}" Foreground="#B0B0B0" FontSize="11" FontFamily="Consolas"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="SHOW RECENT (5)" Background="#2196F3" Foreground="White"
                                FontWeight="Bold" Padding="10,6" Margin="0,0,5,0" Click="LogRecent_Click"/>
                        <Button Grid.Column="1" Content="SHOW ALL" Background="#FF9800" Foreground="White"
                                FontWeight="Bold" Padding="10,6" Margin="5,0,0,0" Click="LogAll_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
